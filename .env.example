# Copie para .env e ajuste conforme necessário.
# Padrão: data/prospectflow.db dentro do projeto
# PF_DATABASE_URL=sqlite:///C:/caminho/para/prospectflow.db
PF_TIMEZONE=America/Sao_Paulo
# DDD usado quando o telefone da planilha vier sem DDD
PF_DEFAULT_DDD=11
PF_HOST=127.0.0.1
PF_PORT=8080
PF_STORAGE_SECRET=troque-este-segredo
PF_DEBUG=false
